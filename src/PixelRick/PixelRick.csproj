<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../Assets/app.ico</ApplicationIcon>
    <AssemblyName>PixelRick</AssemblyName>
    <Product>PixelRick</Product>
    <Description>A tiny pixel scientist for your desktop</Description>
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PixelRick.Core/PixelRick.Core.csproj"/>
    <Using Remove="System.Drawing"/>
    <Using Remove="System.Windows.Forms"/>
  </ItemGroup>
  <Import Project="../PixelRick.Assets/PixelRick.Assets.props"/>
</Project>
